# Copy to .env and fill in. Every variable the service reads is listed here.
# Booleans are true or false; anything else stops the service at start.

# production | development. production: HTTP binds to 127.0.0.1 by default,
# trusts one reverse proxy for the client IP, and the session cookie gets `Secure`.
NODE_ENV=development

# HTTP port, and the address to bind. HOST defaults to 127.0.0.1 in production
# (only the reverse proxy reaches it) and 0.0.0.0 otherwise.
PORT=3000
HOST=

# trace | debug | info | warn | error. At info and above, phone numbers are masked.
LOG_LEVEL=info

# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/bookings

# Both required, at least 32 characters each; the service refuses to start without them.
# Generate each with:  node -p "require('crypto').randomBytes(32).toString('hex')"
# API_TOKEN: for scripts and monitoring (header x-api-token, or ?token=).
API_TOKEN=
# SESSION_SECRET: signs the dashboard login cookie. Changing it logs everyone out.
SESSION_SECRET=

# The 4 groups to listen to, comma-separated. Get the IDs with `npm run groups`.
# Each ID ends with @g.us
TARGET_GROUP_IDS=

# Leave empty to link by scanning a QR in the terminal (default).
# Set to your WhatsApp number (digits only, with country code, e.g. 919876543210)
# to link with a pairing code instead. Only used when the auth folder has no session.
# Link with `npm run groups` in a real terminal. Under pm2 the service never shows
# a QR or pairing code; it stops with status needs_link instead.
PAIRING_PHONE_NUMBER=

# Folder for the WhatsApp session (default ./auth, relative to the project folder).
# It gives FULL ACCESS to the WhatsApp account: anyone with a copy can read the groups.
# It must NOT be inside a cloud-synced folder (OneDrive, Dropbox, Google Drive).
# On Windows this project usually sits in OneDrive\Desktop, so set a path outside it,
# e.g. AUTH_DIR=C:\wa-auth   (Ubuntu: leave empty or e.g. /home/app/wa-auth).
AUTH_DIR=

# Minutes without any group message (08:00-23:00 IST) before the heartbeat alert.
HEARTBEAT_MINUTES=120

# Telegram alert if the WhatsApp session is not connected for this many minutes.
# logged_out / replaced / blocked / needs_link alert at once.
SESSION_DOWN_ALERT_MINUTES=10

# Delete raw messages older than this many days (daily, and at start). 0 = keep forever; max 3650.
# Bookings are kept.
RETENTION_DAYS=30

# ---- Outputs (each off by default; fire once per confirmed booking) ----
# PRIVACY: Telegram alerts, Sheets rows and WhatsApp sends contain the FULL phone
# number and the message, and leave this server (Telegram / Google servers).

# Telegram bot: create one with @BotFather (token like 123456:ABC...). TELEGRAM_CHAT_ID
# is your chat or group id. Also used for heartbeat and session-down alerts.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets append with a service account. Share the sheet with the service
# account's email (Editor). GOOGLE_SHEET_ID is the long id in the sheet URL.
# GOOGLE_SERVICE_ACCOUNT_JSON: ABSOLUTE path to its JSON key file, OUTSIDE this project
# folder (on Windows this folder is usually OneDrive-synced, and git could pick it up).
# The key can write the sheet, which holds every customer phone number.
# e.g. C:\secrets\sheets-sa.json   (Ubuntu: /home/app/.config/booking/sheets-sa.json, chmod 600)
SHEETS_ENABLED=false
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_RANGE=Sheet1!A1

# Sending from the linked WhatsApp number is a BAN RISK; leave false unless you must.
# When true: sends only to TARGET_NUMBER (digits with country code, e.g. 919876543210),
# a random 3-8 s delay before each message, at most 10 per minute.
WHATSAPP_SEND_ENABLED=false
TARGET_NUMBER=

# ---- LLM (OpenAI) for unclear messages; off by default ----
# Off: messages the rules are unsure about go to Review. On: they are sent to
# OpenAI (chat completions, 15 s timeout) to classify and extract.
# PRIVACY: enabling this sends the full message text, INCLUDING PHONE NUMBERS, to OpenAI.
LLM_ENABLED=false
# Both required when LLM_ENABLED=true (the service refuses to start without them).
OPENAI_API_KEY=
# Any chat model that supports JSON-schema structured output; no default.
OPENAI_MODEL=
# LLM confidence (0-1) at or above which a booking is confirmed; below it goes to Review.
LLM_CONFIRM_THRESHOLD=0.8
